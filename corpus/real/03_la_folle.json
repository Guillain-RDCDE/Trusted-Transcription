   "start": 212.62,
   "end": 215.64,
   "text": "Elle tourna vers lui ses yeux vagues, ses yeux vides,",
   "confidence": 0.9687,
   "language": "fr"
  },
  {
   "start": 216.46,
   "end": 217.6,
   "text": "et ne répondit pas.",
   "confidence": 0.9687,
   "language": "fr"
  },
  {
   "start": 218.48,
