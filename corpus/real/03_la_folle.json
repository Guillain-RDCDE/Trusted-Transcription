   "text": "qui leur est particulier.",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 155.2,
   "end": 157.96,
   "text": "Puis les chefs distribuèrent leurs hommes aux habitants.",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 158.74,
   "end": 159.76,
   "text": "J'en eut dix-sept.",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 160.54,
   "end": 163.08,
   "text": "La voisine, la folle, en avait douze,",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 163.6,
   "end": 167.44,
   "text": "dont un commandant, vrai soudard, violent bourru.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 168.56,
   "end": 170.9,
   "text": "Pendant les premiers jours, tout se passait normalement.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 171.26,
   "end": 173.84,
   "text": "On avait dit à l'efficier d'à côté que la dame était malade,",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 174.26,
   "end": 175.52,
   "text": "et il ne s'en inquiète à guerre.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 176.3,
   "end": 178.92,
   "text": "Mais bientôt cette femme qu'on ne voyait jamais l'irita.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 179.62,
   "end": 181.16,
   "text": "Il s'informa de la maladie.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 181.82,
   "end": 183.8,
   "text": "On répondit que son hôtet s'était couché",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 183.8,
   "end": 186.12,
   "text": "depuis quinze ans par suite d'un violent chagrin.",
   "confidence": 0.9833,
   "language": "fr"
  },
  {
   "start": 187.1,
   "end": 188.56,
   "text": "Il n'en crut rien sans doute,",
   "confidence": 0.9833,
   "language": "fr"
  },
