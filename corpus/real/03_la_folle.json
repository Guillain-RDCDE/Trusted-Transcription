   "start": 122.9,
   "end": 125.7,
   "text": "elle demeura ainsi fermée et inerte.",
   "confidence": 0.9862,
   "language": "fr"
  },
  {
   "start": 126.92,
   "end": 127.68,
   "text": "La guerre vint,",
   "confidence": 0.9862,
   "language": "fr"
  },
  {
   "start": 128.52,
   "end": 129.84,
   "text": "et dans les premiers jours de décembre,",
   "confidence": 0.9862,
   "language": "fr"
  },
  {
   "start": 129.98,
   "end": 131.64,
   "text": "les prussiens pénétraient à Cormeille.",
   "confidence": 0.9862,
   "language": "fr"
  },
  {
   "start": 133.02,
   "end": 134.78,
   "text": "Je me rappelle cela comme d'hier.",
   "confidence": 0.9862,
   "language": "fr"
  },
  {
   "start": 135.46,
   "end": 137.74,
   "text": "Il gelait à fondre les pierres,",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 138.1,
   "end": 139.52,
   "text": "et j'étais étendu moi-même",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 139.52,
   "end": 141.92,
   "text": "dans un fauteuil immobilisé par la goutte,",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 142.26,
   "end": 143.8,
   "text": "quand j'entendis le battement lourd",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 143.8,
   "end": 144.98,
   "text": "et rythmé de leur pas.",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 146.08,
   "end": 147.62,
   "text": "De ma fenêtre je l'ai vie passée.",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 148.42,
   "end": 150.6,
   "text": "Il défilait interminablement,",
   "confidence": 0.952,
   "language": "fr"
  },
  {
   "start": 151.18,
   "end": 153.26,
   "text": "tous pareils, avec ce mouvement de pantins",
