   "text": "Elle ne fit pas un geste,",
   "confidence": 0.9876,
   "language": "fr"
  },
  {
   "start": 233.14,
   "end": 235.36,
   "text": "toujours immobile, comme si elle ne lui pas vue.",
   "confidence": 0.9876,
   "language": "fr"
  },
  {
   "start": 236.36,
   "end": 238.8,
   "text": "Il rageait, prenant ce silence calme",
