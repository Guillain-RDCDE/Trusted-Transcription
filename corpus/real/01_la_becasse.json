   "start": 50.4,
   "end": 52.52,
   "text": "Le reste du temps, il lisait.",
   "confidence": 0.7636,
   "language": "fr"
  },
  {
   "start": 52.52,
   "end": 55.6,
   "text": "C'était un homme de commerce aimable",
   "confidence": 0.8449,
   "language": "fr"
  },
  {
