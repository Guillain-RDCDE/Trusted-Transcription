   "text": "il demandait.",
   "confidence": 0.8449,
   "language": "fr"
  },
  {
   "start": 73.06,
   "end": 74.52,
   "text": "Eh bien, quoi de nouveau ?",
   "confidence": 0.8449,
   "language": "fr"
  },
