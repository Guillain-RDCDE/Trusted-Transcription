   "start": 321.4,
   "end": 323.24,
   "text": "On ne revit plus la folle.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 323.84,
   "end": 324.82,
   "text": "Qu'en avait-il fait,",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 325.2,
   "end": 327.16,
   "text": "ou l'avait-il porté ?",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 327.16,
   "end": 327.88,
   "text": "On ne le suit jamais.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 329.48,
   "end": 331.4,
   "text": "La neige tombait maintenant jour et nuit,",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 331.74,
   "end": 333.98,
   "text": "en se velissant la plaine et les bois",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 333.98,
   "end": 335.98,
   "text": "sous un linceul de mousse glacée.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 336.74,
   "end": 338.7,
   "text": "Les loups venaient hurler jusqu'à nos portes.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 339.54,
   "end": 341.76,
   "text": "La pensée de cette femme perdue me hantait.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 342.46,
   "end": 343.92,
   "text": "Et je fis plusieurs démarches",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 343.92,
   "end": 345.48,
   "text": "auprès de l'autorité prussienne",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 345.48,
   "end": 347.54,
   "text": "afin d'obtenir des renseignements.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 348.48,
   "end": 349.84,
   "text": "Je faillis être fusillé.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 351.4,
   "end": 352.74,
   "text": "Le printemps revint.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 353.36,
   "end": 355.1,
   "text": "L'armée d'occupation s'éloigna.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 355.56,
   "end": 357.52,
   "text": "La maison de ma voisine restait fermée.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 358.08,
   "end": 359.9,
   "text": "L'herbe de rue poussait dans les allées.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 361.36,
   "end": 363.22,
   "text": "La vieille bonne était morte pendant l'hiver.",
   "confidence": 0.9939,
   "language": "fr"
  },
  {
   "start": 363.9,
   "end": 366.16,
   "text": "Personne ne s'occupait plus de cette aventure.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 366.54,
   "end": 368.2,
   "text": "Moi seul y songeai sans cesse.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 370.12,
   "end": 372.52,
   "text": "Qu'avait-il fait de cette femme ?",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 372.52,
   "end": 374.22,
   "text": "C'était-elle enfui à travers les bois ?",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 374.88,
   "end": 376.38,
   "text": "L'avait-on recueilli quelque part",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 376.38,
   "end": 377.92,
   "text": "et gardait dans un hôpital",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 377.92,
   "end": 381.22,
   "text": "sans pouvoir obtenir d'elle aucun renseignement ?",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 381.8,
   "end": 383.82,
   "text": "Rien ne venait alléger mes doutes.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 384.58,
   "end": 387.28,
   "text": "Mais peu à peu le temps apaisa le souci de mon cœur.",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 387.88,
   "end": 390.18,
   "text": "Or, à l'automne suivant,",
   "confidence": 0.9965,
   "language": "fr"
  },
  {
   "start": 390.18,
   "end": 392.48,
   "text": "les bécasses passèrent en masse",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 392.48,
   "end": 395.08,
   "text": "et, comme ma goutte me laissait un peu de répit,",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 395.82,
   "end": 397.44,
   "text": "je me traînais jusqu'à la forêt.",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 398.38,
   "end": 401.6,
   "text": "J'avais déjà tué quatre ou cinq oiseaux à l'ombèque,",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 402.22,
   "end": 405.28,
   "text": "quand j'en ai bâti un qui disparut dans un fossé plein de branches.",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 405.98,
   "end": 408.86,
   "text": "Je fus obligé d'y descendre pour ira masser ma bête.",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 410.06,
   "end": 412.54,
   "text": "Je l'a trouvée tombée auprès d'une tête de mort.",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 413.22,
   "end": 417.1,
   "text": "Et brusquement le souvenir de la folle m'arriva dans la poitrine comme un coup de poing.",
   "confidence": 0.9844,
   "language": "fr"
  },
  {
   "start": 417.8,
   "end": 421.1,
   "text": "Bien d'autres avaient expiré dans ces bois peut-être en cette année sinistre.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 422.36,
   "end": 423.44,
   "text": "Mais je ne sais pas pourquoi.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 423.98,
   "end": 426.38,
   "text": "J'étais sûr, sûr, vous dis-je,",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 427.0,
   "end": 429.92,
   "text": "que je rencontrais la tête de cette misérable maniaque.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 430.52,
   "end": 431.66,
   "text": "Et soudain je compris.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 432.34,
   "end": 433.22,
   "text": "Je devinais tout.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 434.1,
   "end": 437.74,
   "text": "Il l'avait abandonné sur ce matelas dans la forêt froide des désertes.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 438.28,
   "end": 440.1,
   "text": "Et fidèle a son idée fixe,",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 440.84,
   "end": 444.28,
   "text": "elle s'était laissée mourir sous l'épée et léger du vais des neiges",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 444.28,
   "end": 446.72,
   "text": "et sans remuer le bras ou la jambe.",
   "confidence": 0.9902,
   "language": "fr"
  },
  {
   "start": 447.48,
   "end": 449.16,
   "text": "Puis les loups l'avaient dévoré",
   "confidence": 0.9961,
   "language": "fr"
  },
  {
   "start": 449.16,
   "end": 453.14,
   "text": "et les oiseaux avaient fait leur nid avec la laine de son lit déchiré.",
   "confidence": 0.9961,
   "language": "fr"
  },
  {
   "start": 454.4,
   "end": 456.04,
   "text": "J'ai gardé ce tristosement.",
   "confidence": 0.9961,
   "language": "fr"
  },
  {
   "start": 456.64,
   "end": 459.48,
   "text": "Je fais des vœux pour que nos fils ne voient plus jamais de guerre.",
   "confidence": 0.9961,
   "language": "fr"
  },
  {
   "start": 461.28,
   "end": 463.48,
   "text": "5 décembre 1882.",
   "confidence": 0.9961,
   "language": "fr"
  },
  {
   "start": 465.98,
   "end": 467.26,
   "text": "Fin de la folle.",
   "confidence": 0.9961,
   "language": "fr"
  }
