   "end": 252.8,
   "text": "Soudain, il touche à le fond.",
   "confidence": 0.9744,
   "language": "fr"
  },
  {
   "start": 253.78,
   "end": 256.02,
   "text": "Mais une haute lame inclinant le bateau,",
   "confidence": 0.9744,
   "language": "fr"
  },
  {
   "start": 256.54,
   "end": 258.42,
   "text": "j'avais le cadet qui se trouvait à l'avant",
   "confidence": 0.9744,
   "language": "fr"
  },
  {
   "start": 258.42,
   "end": 260.04,
   "text": "et dirigait la descente du filet,",
   "confidence": 0.9744,
   "language": "fr"
  },
  {
   "start": 260.04,
   "end": 263.88,
   "text": "chant cela et son bras se trouva saisie entre la corde,",
   "confidence": 0.9981,
   "language": "fr"
  },
  {
   "start": 264.2,
   "end": 268.2,
   "text": "un instant détendu par la secousse et le bois où elle glissait.",
   "confidence": 0.9981,
   "language": "fr"
  },
  {
   "start": 269.0,
   "end": 271.86,
   "text": "Il fit un effort désespéré, tachant de l'autre main",
