   "start": 302.02,
   "end": 304.98,
   "text": "Mais couper, s'était perdre le chalut.",
   "confidence": 0.9908,
   "language": "fr"
  },
  {
   "start": 305.62,
   "end": 307.14,
   "text": "Et ce chalut valait de l'argent,",
   "confidence": 0.9908,
   "language": "fr"
  },
  {
   "start": 307.8,
   "end": 310.66,
   "text": "beaucoup d'argent, quinze cents francs,",
   "confidence": 0.9908,
   "language": "fr"
  },
