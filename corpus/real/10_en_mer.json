   "text": "et il tira de sa poche un large couteau",
   "confidence": 0.9908,
   "language": "fr"
  },
  {
   "start": 297.48,
   "end": 300.94,
   "text": "qui pouvait en deux coups sauver le bras de Javel Cadet.",
   "confidence": 0.9908,
   "language": "fr"
  },
